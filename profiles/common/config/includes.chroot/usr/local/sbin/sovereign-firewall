#!/bin/sh
set -eu

usage() {
  cat >&2 <<'EOF'
Usage: sovereign-firewall <desktop|server|status|disable>

  desktop  deny unsolicited inbound traffic
  server   deny unsolicited inbound traffic but allow OpenSSH
  status   show current UFW status
  disable  disable UFW without deleting its rules
EOF
}

if [ "$(id -u)" -ne 0 ]; then
  echo "Run this command as root." >&2
  exit 1
fi

command -v ufw >/dev/null 2>&1 || { echo "UFW is not installed." >&2; exit 1; }

case "${1:-}" in
  desktop)
    ufw default deny incoming
    ufw default allow outgoing
    ufw --force enable
    ;;
  server)
    ufw default deny incoming
    ufw default allow outgoing
    ufw allow OpenSSH comment 'Sovereign Stack remote administration'
    ufw --force enable
    ;;
  status)
    ufw status verbose
    ;;
  disable)
    ufw disable
    ;;
  *)
    usage
    exit 2
    ;;
esac
